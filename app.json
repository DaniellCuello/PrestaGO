{
  "expo": {
    "name": "PrestaGo",
    "slug": "PrestaGo",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prestago",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1AA965",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "PrestaGo necesita acceso a tus contactos para importar el número de WhatsApp y nombre de tus clientes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PrestaGo necesita acceso a tu ubicación GPS para registrar la dirección exacta de cobro del cliente en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PrestaGo necesita acceso a tu galería para seleccionar tu foto de perfil de administrador.",
          "cameraPermission": "PrestaGo necesita acceso a tu cámara para capturar tu foto de perfil de administrador."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
